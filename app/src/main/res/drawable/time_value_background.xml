<?xml version="1.0" encoding="utf-8"?>
<!-- The spinners' box without the dropdown arrow: this opens a picker, not a menu, so the
     arrow would promise the wrong gesture. Wrapped in a ripple, which the Spinner gets from
     its own widget and a plain TextView does not. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:drawable="@drawable/spinner_box" />
</ripple>
