<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:padding="24dp"
	android:fitsSystemWindows="true">

	<!-- Material3 Top App Bar (NO navigation icon) -->
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/topBar"
		android:layout_width="0dp"
		android:layout_height="?attr/actionBarSize"
		android:title="@string/settings_title"
		app:titleCentered="true"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />

	<!-- Dark Theme label -->
    <TextView
        android:id="@+id/settingsThemeTitle"
        android:layout_width="wrap_content"
        android:layout_height="31dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        android:text="@string/dark_theme"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

	<!-- Theme Spinner -->
	<Spinner
		android:id="@+id/themeSpinner"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="32dp"
		android:minHeight="48dp"
		android:background="@drawable/spinner_background"
		android:paddingStart="12dp"
		android:paddingEnd="36dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/settingsThemeTitle"
		app:layout_constraintBottom_toBottomOf="@id/settingsThemeTitle" />

	<!-- Translation label -->
	<TextView
		android:id="@+id/settingsTranslationTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:layout_marginStart="24dp"
		android:text="@string/translation"
		android:textSize="20sp"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/settingsThemeTitle" />

	<!-- Translation Spinner -->
	<Spinner
		android:id="@+id/translationSpinner"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="32dp"
		android:minHeight="48dp"
		android:background="@drawable/spinner_background"
		android:paddingStart="12dp"
		android:paddingEnd="36dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/settingsTranslationTitle"
		app:layout_constraintBottom_toBottomOf="@id/settingsTranslationTitle" />

	<!-- Show Translation Info label -->
	<TextView
		android:id="@+id/showTranslationInfoTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:layout_marginStart="24dp"
		android:text="@string/show_translation_info"
		android:textSize="20sp"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/settingsTranslationTitle" />

	<!-- Show Translation Info Switch -->
	<com.google.android.material.switchmaterial.SwitchMaterial
		android:id="@+id/showTranslationInfoSwitch"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="32dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/showTranslationInfoTitle"
		app:layout_constraintBottom_toBottomOf="@id/showTranslationInfoTitle" />

	<!-- Daily Verse Notification label -->
	<TextView
		android:id="@+id/dailyVerseNotificationTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:layout_marginStart="24dp"
		android:text="@string/daily_verse_notification"
		android:textSize="20sp"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/showTranslationInfoTitle" />

	<!-- Daily Verse Notification Switch -->
	<com.google.android.material.switchmaterial.SwitchMaterial
		android:id="@+id/dailyVerseNotificationSwitch"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="32dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/dailyVerseNotificationTitle"
		app:layout_constraintBottom_toBottomOf="@id/dailyVerseNotificationTitle" />

	<!-- Notification Time label. Its own row in the same shape as every row above it
	     (title on the left, control on the right) — carried in the notification row's
	     summary line it read as descriptive text, and nobody found the picker in it. -->
	<TextView
		android:id="@+id/notificationTimeTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:layout_marginStart="24dp"
		android:labelFor="@id/notificationTimeValue"
		android:text="@string/daily_verse_notification_time"
		android:textSize="20sp"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/dailyVerseNotificationTitle" />

	<!-- Notification Time value — the control, sized and boxed like the spinners so it
	     reads as one. Text is written in code; the tools:text is for the preview only. -->
	<TextView
		android:id="@+id/notificationTimeValue"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="32dp"
		android:minHeight="48dp"
		android:minWidth="96dp"
		android:background="@drawable/time_value_background"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center"
		android:paddingHorizontal="16dp"
		android:textSize="16sp"
		tools:text="8:00 AM"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/notificationTimeTitle"
		app:layout_constraintBottom_toBottomOf="@id/notificationTimeTitle" />

	<!-- Privacy Policy label. Not a setting — it opens the published policy in a browser —
	     but it keeps the same row shape as everything above it, because a row that breaks
	     the rhythm reads as description rather than as something you can tap (see the
	     notification time note above, which was exactly that mistake).

	     The 40dp top margin is the one deviation from the 24dp every other row uses. Rows
	     here pair a ~24dp title with a 48dp boxed control, so at a 24dp pitch two *boxed*
	     rows leave their boxes touching edge to edge, reading as one double-height box.
	     This is the first time two boxed rows are adjacent — the time row used to be last,
	     with nothing under it. Any further boxed row added below needs the same treatment. -->
	<TextView
		android:id="@+id/privacyPolicyTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="40dp"
		android:layout_marginStart="24dp"
		android:labelFor="@id/privacyPolicyValue"
		android:text="@string/privacy_policy"
		android:textSize="20sp"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/notificationTimeTitle" />

	<!-- Privacy Policy control — boxed like the time value so the two read as the same
	     kind of affordance. Reuses time_value_background; the name is historical. -->
	<TextView
		android:id="@+id/privacyPolicyValue"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="32dp"
		android:minHeight="48dp"
		android:minWidth="96dp"
		android:background="@drawable/time_value_background"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center"
		android:paddingHorizontal="16dp"
		android:text="@string/privacy_policy_open"
		android:textSize="16sp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/privacyPolicyTitle"
		app:layout_constraintBottom_toBottomOf="@id/privacyPolicyTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
