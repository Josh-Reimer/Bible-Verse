<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomSwitchStyle" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_color</item>
        <item name="trackTint">@color/switch_track_color</item>
    </style>

    <!-- colorPrimary is repurposed app-wide to match colorSurface (so the toolbar isn't
         tinted), and the time picker paints the clock hand, the selected number and the
         OK/Cancel text with it — all of which would vanish against the dialog's
         surface-colored background in light theme. Give the picker a real accent back,
         the same way SettingsActivity forces a color onto the AlertDialog buttons. -->
    <style name="ThemeOverlay.VerseApp.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/green_700_primary</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- Easter easter egg (see Easter.java), applied by MainActivity from Good Friday to
         Easter Sunday. The dark overlay turns everything the toolbar draws (title, drawer
         toggle, search icon and the expanded SearchView's text) light, to sit on the color. -->
    <style name="Theme.VerseApp.Passion">
        <item name="toolbarStyle">@style/Widget.VerseApp.Toolbar.Passion</item>
    </style>

    <style name="Widget.VerseApp.Toolbar.Passion" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/passion_purple</item>
        <item name="titleTextColor">@color/white</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <style name="Theme.VerseApp.Resurrection">
        <item name="toolbarStyle">@style/Widget.VerseApp.Toolbar.Resurrection</item>
    </style>

    <style name="Widget.VerseApp.Toolbar.Resurrection" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/resurrection_gold</item>
        <item name="titleTextColor">@color/white</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>
</resources>