<resources>
    <style name="Theme.VerseApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Dark mode status bar; transparent system bars set in code via
             EdgeToEdge.enable() instead of the deprecated statusBarColor/navigationBarColor
             theme attributes. -->
        <item name="colorPrimaryContainer">@color/green_700_primary</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorPrimary">@color/green_700_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Tuned for ExposedDropdownMenu contrast against colorSurface -->
        <item name="colorSurfaceVariant">#3A3A3A</item>
        <item name="colorOutline">#8A8A8A</item>
        <item name="colorSecondaryContainer">#2E332E</item>

        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>

        <item name="colorControlActivated">@color/green_700_primary</item>

        <item name="android:windowLightNavigationBar">false</item>

        <!-- Material3-specific: disable dynamic system bar theming -->
        <item name="statusBarForeground">@null</item>

    </style>
</resources>
